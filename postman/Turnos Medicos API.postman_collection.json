          "raw": "{\r\n  \"medicoId\": 1,\r\n  \"paciente\": \"Lucas Rossi\",\r\n  \"documento\": \"35123456\",\r\n  \"fecha\": \"15/09/2026\",\r\n  \"especialidad\": \"Clínica Médica\"\r\n}\r\n",
