            "packages": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 201 Created\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "if (jsonData.id) {\r",
              "    // Guarda el ID devuelto en una variable de entorno para usarlo después\r",
              "    pm.environment.set(\"appointmentId\", jsonData.id);\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
